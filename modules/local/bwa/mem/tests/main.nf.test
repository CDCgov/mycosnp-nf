nextflow_process {

    name "Test Process BWA_MEM (local)"
    script "../main.nf"
    process "BWA_MEM"

    tag "modules"
    tag "module_nfcore"
    tag "bwa"
    tag "bwa/mem"
    tag "bwa/index"

    setup {
        run("BWA_INDEX") {
            script "../../../../nf-core/bwa/index/main.nf"
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("Paired-End with RG") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BWA_INDEX.out.index.map{ it[1] }
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot( process.out ).match()
                }
            )
        }

    }

    test("Paired-End - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BWA_INDEX.out.index.map{ it[1] }
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot (process.out ).match() }
            )
        }
    }
}
