nextflow_process {

    name "Test Process COORDSTOBED"
    script "../main.nf"
    process "COORDSTOBED"

    tag "modules"
    tag "modules/local/coordstobed"
    tag "COORDSTOBED"

    test("COORDSTOBED - convert detla to bed file") {

        when {
            process {
                """
                input[0] = [
                    [ id:'reference'],
                    file(params.modules_testdata_base_path + '/genomics/fungal/genome/alignment/nucmer/test.delta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("COORDSTOBED - stub test") {

        options "-stub"

        when {
            process {
                 """
                input[0] = [
                    [ id:'reference'],
                    file(params.modules_testdata_base_path + '/genomics/fungal/genome/alignment/nucmer/test.delta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
