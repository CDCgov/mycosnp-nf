nextflow_process {

    name "Test Process PICARD_ADDORREPLACEREADGROUPS (local)"
    tag "modules_local"
    tag "modules"
    tag "picard"
    tag "addorreplacereadgroups"
    script "../main.nf"
    process "PICARD_ADDORREPLACEREADGROUPS"

    test("Replace RGs from meta when ext.args empty") {

        when {
            process {
                """
                input[0] = [ 
                    [ id:'test' ], 
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Respect ext.args if set") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [ 
                    [ id:'test' ], 
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("PICARD_ADDORREPLACEREADGROUPS - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ 
                    [ id:'test' ], 
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
