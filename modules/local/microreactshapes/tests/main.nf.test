nextflow_process {

    name "Test Process MICROREACTSHAPES"
    script "../main.nf"
    process "MICROREACTSHAPES"
    config "./nextflow.config"

    tag "modules"
    tag "microreactshapes"

    test("MICROREACTSHAPES - Output Validation") {

        when {
            process {
                 """
                // input[0]: tuple(val(meta), path(tree))
                input[0] = [
                    [ id: "S1" ],
                    file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/microreactshapes/quicksnp_phylogeny.nwk")
                ]
                // input[1]: metadata table
                input[1] = file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/microreactshapes/metadata.csv")
                // input[2]: geolocation table
                input[2] = file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/microreactshapes/geolocation.csv")
                """
            }
        }
        then {
            def outTuple = process.out.shapes[0]
            def metaMap = outTuple[0]
            def outFile = file(outTuple[1])
            assertAll(
                { assert process.success },
                { assert metaMap.id == "S1" },
                { assert outFile.name == "microreact_metadata.csv" },
                { assert outFile.exists() }
            )
        }
    }

    test("MICROREACTSHAPES - stub test") {

        options "-stub"

        when {
            process {
                """
                // input[0]: tuple(val(meta), path(tree))
                input[0] = [
                    [ id: "S1" ],
                    file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/microreactshapes/quicksnp_phylogeny.nwk")
                ]
                // input[1]: metadata table
                input[1] = file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/microreactshapes/metadata.csv")
                // input[2]: geolocation table
                input[2] = file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/microreactshapes/geolocation.csv")
                """
            }
        }
        then {
            def outTuple = process.out.shapes[0]
            def outFile = file(outTuple[1])
            assertAll(
                { assert process.success },
                { assert outFile.exists() }
            )
        }
    }
}
