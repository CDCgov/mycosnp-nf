nextflow_process {

    name "Test Process SUBTYPE"
    script "../main.nf"
    process "SUBTYPE"

    tag "modules"
    tag "sourmash"
    tag "subtype"
    tag "modules/subtype"

    setup {
        run("UNTAR") {
            script "modules/nf-core/untar/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [],
                    file(
                        params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/sourmash/sourmash_db.tar.gz',
                        checkIfExists: true
                    )
                ])
                """
            }
        }
    }

    test("test-subtype") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/premycosnp_indv_comb_summary/SRR30604805_gambit.csv', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map{ it[1] }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("test-subtype-stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/premycosnp_indv_comb_summary/SRR30604805_gambit.csv', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map{ it[1] }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
