nextflow_process {

    name "Test Process QC_PARSER"
    script "../main.nf"
    process "QC_PARSER"
    config "./nextflow.config"

    tag "modules"
    tag "qc_parser"

    test("QC_PARSER - Output Validation") {

        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/qc_parser/qc_report.txt")
                """
            }
        }
        then {
            def outFile = file(process.out.qc_fail_pass[0])
            assertAll(
                { assert process.success },
                { assert outFile.exists() },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("QC_PARSER - stub test") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + "/genomics/eukaryotes/candida_auris/qc_parser/qc_report.txt")
                """
            }
        }
        then {
            def outFile = file(process.out.qc_fail_pass[0])
            assertAll(
                { assert process.success },
                { assert outFile.exists() },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
