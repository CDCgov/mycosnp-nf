nextflow_process {

    name "Test Process VCF_TO_FASTA"
    script "../main.nf"
    process "VCF_TO_FASTA"

    tag "modules"
    tag "vcftools"
    tag "local/vcftools"
    tag "vcf_to_fasta"

    test("test-vcf-to-fasta") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/genomics/fungal/vcfqc/samplelist.txt', checkIfExists: true),
                    [],
                    [1],
                    [10]
                    ]
                input[1] = [file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("test-vcf-to-fasta-stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/genomics/fungal/vcfqc/samplelist.txt', checkIfExists: true),
                    [],
                    [1],
                    [10]
                    ]
                input[1] = [file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
