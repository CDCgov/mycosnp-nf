nextflow_process {

    name "Test Process SNPEFF_SNPEFF"
    script "../main.nf"
    process "SNPEFF_SNPEFF"
    config "./nextflow.config"
    tag "modules"
    tag "modules_nfcore"
    tag "modules_snpeff"
    tag "snpeff"
    tag "snpeff/snpeff"

    test("test_SNPEFF_SNPEFF") {

        when {
            process {
                """
                // Create snpeff cache directory structure
                def snpeff_cache_dir = file("\$PWD/snpeff")
                snpeff_cache_dir.mkdirs()
                def snpeff_db_dir = file("\$PWD/snpeff/candida_auris_gca_016772135.1")
                snpeff_db_dir.mkdirs()

                // Download and stage snpEff.config
                def snpeff_config_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/snpEff.config', checkIfExists: true)
                snpeff_config_src.copyTo(file("\$PWD/snpeff/snpEff.config"))

                // Download and stage database files
                def cds_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/cds.fa', checkIfExists: true)
                def genes_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/genes.gff', checkIfExists: true)
                def protein_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/protein.fa', checkIfExists: true)
                def sequences_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/sequences.fa', checkIfExists: true)
                def predictor_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/snpEffectPredictor.bin', checkIfExists: true)

                cds_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/cds.fa"))
                genes_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/genes.gff"))
                protein_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/protein.fa"))
                sequences_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/sequences.fa"))
                predictor_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/snpEffectPredictor.bin"))

                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/gatk4_localcombinegvcfs/SRR30604805.g.vcf.gz', checkIfExists: true)
                ])
                input[1] = params.snpeff_db
                input[2] = Channel.of([
                    [ id: params.snpeff_db ],
                    snpeff_cache_dir
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() },
                { assert process.out.vcf.size() == 1 },
                { assert process.out.report.size() == 1 },
                { assert process.out.summary_html.size() == 1 },
                { assert process.out.genes_txt.size() == 1 }
            )
        }
    }

    test("test_SNPEFF_SNPEFF -stub") {

        options "-stub"

        when {
            process {
                """
                // Create snpeff cache directory structure
                def snpeff_cache_dir = file("\$PWD/snpeff")
                snpeff_cache_dir.mkdirs()
                def snpeff_db_dir = file("\$PWD/snpeff/candida_auris_gca_016772135.1")
                snpeff_db_dir.mkdirs()

                // Download and stage snpEff.config
                def snpeff_config_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/snpEff.config', checkIfExists: true)
                snpeff_config_src.copyTo(file("\$PWD/snpeff/snpEff.config"))

                // Download and stage database files
                def cds_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/cds.fa', checkIfExists: true)
                def genes_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/genes.gff', checkIfExists: true)
                def protein_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/protein.fa', checkIfExists: true)
                def sequences_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/sequences.fa', checkIfExists: true)
                def predictor_src = file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/snpeff/candida_auris_gca_016772135.1/snpEffectPredictor.bin', checkIfExists: true)

                cds_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/cds.fa"))
                genes_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/genes.gff"))
                protein_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/protein.fa"))
                sequences_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/sequences.fa"))
                predictor_src.copyTo(file("\$PWD/snpeff/candida_auris_gca_016772135.1/snpEffectPredictor.bin"))

                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + '/genomics/eukaryotes/candida_auris/gatk4_localcombinegvcfs/SRR30604805.g.vcf.gz', checkIfExists: true)
                ])
                input[1] = params.snpeff_db
                input[2] = Channel.of([
                    [ id: params.snpeff_db ],
                    snpeff_cache_dir
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() },
                { assert process.out.vcf.size() == 1 },
                { assert process.out.report.size() == 1 },
                { assert process.out.summary_html.size() == 1 },
                { assert process.out.genes_txt.size() == 1 }
            )
        }
    }
}
