nextflow_process {

    name "Test Process FILTER_GATK_GENOTYPES"
    script "../main.nf"
    process "FILTER_GATK_GENOTYPES"

    tag "modules"
    tag "vcftools"
    tag "local/vcftools"
    tag "filter_gatk_genotypes"

    test("test-filter-gatk-genotypes") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("test-filter-gatk-genotypes-stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
