nextflow_process {
    name "Test Process VCF_QC"
    script "../main.nf"
    process "VCF_QC"

    tag "modules"
    tag "modules/local/vcfqc"
    tag "vcfqc"

    // Full execution (uses real awk logic)
    test("VCF_QC - Output Validation") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = file("https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/modules-fungal/data/genomics/fungal/vcfqc/vcf-to-fasta.fasta")
                """
            }
        }
        then {
            def report = file(process.out.vcf_qc_report[0])
            def passed = file(process.out.vcf_qc_passed[0])
            assertAll(
                { assert process.success },
                { assert report.exists() },
                { assert passed.exists() },
                // Header + 2 sample lines expected
                { assert report.text.readLines().size() >= 3 },
                { assert report.text.contains("B11842") },
                { assert report.text.contains("B11858") },
                // Second passing sample should appear in passed list per module logic
                { assert passed.text.contains("B11858") }
            )
        }
    }

    // Stub execution
    test("VCF_QC - stub test") {
        options "-stub"
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = file("https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/modules-fungal/data/genomics/fungal/vcfqc/vcf-to-fasta.fasta")
                """
            }
        }
        then {
            def report = file(process.out.vcf_qc_report[0])
            def passed = file(process.out.vcf_qc_passed[0])
            assertAll(
                { assert process.success },
                { assert report.exists() },
                { assert passed.exists() }
            )
        }
    }
}
