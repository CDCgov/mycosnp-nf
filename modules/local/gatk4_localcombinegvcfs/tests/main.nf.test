nextflow_process {

    name "Test Process GATK4_LOCALCOMBINEGVCFS"
    script "../main.nf"
    process "GATK4_LOCALCOMBINEGVCFS"

    tag "modules"
    tag "modules/local/gatk4_localcombinegvcfs"
    tag "GATK4_LOCALCOMBINEGVCFS"

    test("GATK4_LOCALCOMBINEGVCFS - script") {

        when {
            process {
                """
                input[0] = [id:'combined', single_end:false]
                input[1] = [
                    file(params.modules_testdata_base_path + '/genomics/fungal/gatk4_localcombinegvcfs/SRR30604805.g.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/genomics/fungal/gatk4_localcombinegvcfs/SRR30604805.g.vcf.gz.tbi', checkIfExists: true)
                ]
                input[2] = file(params.modules_testdata_base_path + '/genomics/fungal/reference/reference.fa', checkIfExists: true)
                input[3] = file(params.modules_testdata_base_path + '/genomics/fungal/reference/reference.fa.fai', checkIfExists: true)
                input[4] = file(params.modules_testdata_base_path + '/genomics/fungal/reference/reference.dict', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    process.out.tbi ).match() },
                { assert process.out.gvcf.size() > 0 }

            )
        }
    }

    test("GATK4_LOCALCOMBINEGVCFS - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [id:'combined', single_end:false]
                input[1] = [
                    file(params.modules_testdata_base_path + '/genomics/fungal/gatk4_localcombinegvcfs/SRR30604805.g.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/genomics/fungal/gatk4_localcombinegvcfs/SRR30604805.g.vcf.gz.tbi', checkIfExists: true)
                ]
                input[2] = file(params.modules_testdata_base_path + '/genomics/fungal/reference/reference.fa', checkIfExists: true)
                input[3] = file(params.modules_testdata_base_path + '/genomics/fungal/reference/reference.fa.fai', checkIfExists: true)
                input[4] = file(params.modules_testdata_base_path + '/genomics/fungal/reference/reference.dict', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot( process.out.versions ).match() }
            )
        }
    }
}
