nextflow_process {

    name "Test Process SNPEFFR"
    script "../main.nf"
    process "SNPEFFR"

    tag "modules"
    tag "snpeffr"
    tag "local/snpeffr"

    test("test-snpeffr") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ]
                input[1] =['test']
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("test-snpeffr-stub") {
        options '-stub'
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ]
                input[1] =['test']
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
