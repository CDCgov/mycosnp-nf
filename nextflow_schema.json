{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/CDCgov/mycosnp-nf/master/nextflow_schema.json",
    "title": "CDCgov/mycosnp-nf",
    "description": "MycoSNP is a portable workflow for performing whole genome sequencing analysis of fungal organisms, including Candida auris. This method prepares the reference, performs quality control, and calls variants using a reference. MycoSNP generates several output files that are compatible with downstream analytic tools, such as those for used for phylogenetic tree-building and gene variant annotations.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/Output Options",
            "type": "object",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["input", "outdir"],
            "fa_icon": "fas fa-terminal",
            "properties": {
                "input": {
                    "type": "string",
                    "description": "Path to comma-separated file containing information about the samples in the experiment.",
                    "pattern": "^\\S+\\.csv$",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "schema": "assets/schema_input.json",
                    "exists": true,
                    "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with 3 columns, and a header row.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "format": "directory-path",
                    "fa_icon": "fas fa-folder-open"
                },
                "multiqc_title": {
                    "type": "string",
                    "description": "MultiQC report title. Printed as page header, used for filename if not otherwise specified.",
                    "fa_icon": "fas fa-file-signature"
                },
                "fasta": {
                    "type": "string",
                    "description": "Path to the reference genome FASTA file.",
                    "fa_icon": "fas fa-file-genome"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for completion summary.",
                    "format": "email",
                    "fa_icon": "fas fa-envelope"
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for completion summary on failure only.",
                    "format": "email",
                    "fa_icon": "fas fa-exclamation-triangle"
                },
                "plaintext_email": {
                    "type": "boolean",
                    "description": "Send plain-text email instead of HTML.",
                    "default": false,
                    "fa_icon": "fas fa-remove-format"
                }
            }
        },
        "institutional_config_options": {
            "title": "Institutional Config Options",
            "type": "object",
            "description": "Parameters used to describe centralised config profiles. These should not be edited.",
            "help_text": "The centralised nf-core configuration profiles use a handful of pipeline parameters to describe themselves. This information is then printed to the Nextflow log when you run a pipeline. You should not need to change these values when you run a pipeline.",
            "fa_icon": "fas fa-university",
            "properties": {
                "custom_config_version": {
                    "type": "string",
                    "description": "Git commit id for Institutional configs.",
                    "default": "master",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "custom_config_base": {
                    "type": "string",
                    "description": "Base directory for Institutional configs.",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "hidden": true,
                    "help_text": "If you're running offline, Nextflow will not be able to fetch the institutional config files from the internet. If you don't need them, then this is not a problem. If you do need them, you should download the files from the repo and tell Nextflow where to find them with this parameter.",
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_name": {
                    "type": "string",
                    "description": "Institutional config name.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_description": {
                    "type": "string",
                    "description": "Institutional config description.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_contact": {
                    "type": "string",
                    "description": "Institutional config contact information.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_url": {
                    "type": "string",
                    "description": "Institutional config URL link.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                }
            }
        },
        "mycosnp_options": {
            "title": "MycoSNP Analysis Options",
            "type": "object",
            "description": "Options for configuring the MycoSNP analysis workflow.",
            "fa_icon": "fas fa-dna",
            "properties": {
                "mode": {
                    "type": "string",
                    "description": "Specify which workflow to run.",
                    "enum": ["PRE_MYCOSNP", "NFCORE_MYCOSNP"],
                    "default": "NFCORE_MYCOSNP",
                    "fa_icon": "fas fa-project-diagram"
                },
                "min_contig_cov": {
                    "type": "integer",
                    "description": "Minimum contig coverage.",
                    "default": 10,
                    "fa_icon": "fas fa-align-left"
                },
                "min_contig_len": {
                    "type": "integer",
                    "description": "Minimum contig length.",
                    "default": 300,
                    "fa_icon": "fas fa-ruler-horizontal"
                },
                "gambit_db": {
                    "type": "string",
                    "description": "Path to GAMBIT database file.",
                    "fa_icon": "fas fa-database"
                },
                "gambit_h5_dir": {
                    "type": "string",
                    "description": "Path to GAMBIT H5 signatures directory.",
                    "fa_icon": "fas fa-folder"
                },
                "subtype_db": {
                    "type": "string",
                    "description": "Path to subtyping database directory.",
                    "fa_icon": "fas fa-database"
                },
                "species": {
                    "type": "string",
                    "description": "Species identifier for analysis.",
                    "default": "candida_auris_gca_016772135.1",
                    "fa_icon": "fas fa-microscope"
                },
                "genes": {
                    "type": "string",
                    "description": "Gene identifiers for analysis.",
                    "default": "CAB11_002014",
                    "fa_icon": "fas fa-dna"
                },
                "positions": {
                    "type": "string",
                    "description": "Genomic positions for analysis.",
                    "default": "fks1_hs1=221637:221663,fks1_hs2=223782:223805,fks1_hs3=221805:221807",
                    "fa_icon": "fas fa-map-marker-alt"
                },
                "exclude": {
                    "type": "string",
                    "description": "Variant types to exclude from analysis.",
                    "default": "synonymous_variant",
                    "fa_icon": "fas fa-filter"
                },
                "save_reference": {
                    "type": "boolean",
                    "description": "Save reference files in output.",
                    "default": true,
                    "fa_icon": "fas fa-save"
                },
                "save_alignment": {
                    "type": "boolean",
                    "description": "Save alignment files in output.",
                    "default": true,
                    "fa_icon": "fas fa-save"
                },
                "sample_ploidy": {
                    "type": "integer",
                    "description": "Sample ploidy level.",
                    "default": 1,
                    "fa_icon": "fas fa-layer-group"
                },
                "coverage": {
                    "type": "integer",
                    "description": "Desired sample coverage for seqtk_sample. If 0, seqtk_sample will not be performed.",
                    "default": 0,
                    "fa_icon": "fas fa-chart-area"
                },
                "gvcfs_filter": {
                    "type": "string",
                    "description": "GVCF filtering criteria.",
                    "default": "QD < 2.0 || FS > 60.0 || MQ < 40.0 || DP < 10",
                    "fa_icon": "fas fa-filter"
                },
                "gatkgenotypes_filter": {
                    "type": "string",
                    "description": "GATK genotypes filtering parameters.",
                    "default": "--min_GQ \"50\" --keep_GQ_0_refs --min_percent_alt_in_AD \"0.8\" --min_total_DP \"10\" --keep_all_ref",
                    "fa_icon": "fas fa-filter"
                },
                "max_amb_samples": {
                    "type": "integer",
                    "description": "Maximum number of ambiguous samples.",
                    "default": 10000000,
                    "fa_icon": "fas fa-exclamation-triangle"
                },
                "max_perc_amb_samples": {
                    "type": "integer",
                    "description": "Maximum percentage of ambiguous samples.",
                    "default": 10,
                    "fa_icon": "fas fa-percent"
                },
                "min_depth": {
                    "type": "integer",
                    "description": "Minimum sequencing depth.",
                    "default": 10,
                    "fa_icon": "fas fa-layer-group"
                },
                "rapidnj": {
                    "type": "boolean",
                    "description": "Enable RapidNJ phylogenetic analysis.",
                    "default": true,
                    "fa_icon": "fas fa-tree"
                },
                "fasttree": {
                    "type": "boolean",
                    "description": "Enable FastTree phylogenetic analysis.",
                    "default": true,
                    "fa_icon": "fas fa-tree"
                },
                "snpeffcache": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Database cache to use for SNPEFF processes.",
                    "fa_icon": "fas fa-folder-open"
                },
                "snpeff": {
                    "type": "boolean",
                    "description": "Boolean to determine whether or not to run snpeff.",
                    "fa_icon": "fas fa-ban",
                    "default": false
                },
                "ref_name": {
                    "type": "string",
                    "description": "Reference name for snpeffr output file.",
                    "fa_icon": "fas fa-cog"
                },
                "genome": {
                    "type": "string",
                    "description": "Name of iGenomes reference.",
                    "fa_icon": "fas fa-book",
                    "help_text": "If using a reference genome configured in the pipeline using iGenomes, use this parameter to give the ID for the reference. This is then used to build the full paths for all required reference genome files e.g. `--genome GRCh38`. \n\nSee the [nf-core website docs](https://nf-co.re/usage/reference_genomes) for more details."
                },
                "igenomes_ignore": {
                    "type": "boolean",
                    "description": "Do not load the iGenomes reference config.",
                    "fa_icon": "fas fa-ban",
                    "hidden": true,
                    "help_text": "Do not load `igenomes.config` when running the pipeline. You may choose this option if you observe clashes between custom parameters and those supplied in `igenomes.config`.",
                    "default": true
                }
            }
        },
        "reference_options": {
            "title": "Reference Genome Options",
            "type": "object",
            "description": "Options for reference genome configuration.",
            "fa_icon": "fas fa-dna",
            "properties": {
                "igenomes_base": {
                    "type": "string",
                    "description": "Base URL or path for iGenomes references.",
                    "default": "s3://ngi-igenomes/igenomes",
                    "fa_icon": "fas fa-cloud"
                }
            }
        },
        "reporting_options": {
            "title": "Reporting Options",
            "type": "object",
            "description": "Options for pipeline reporting and tracking.",
            "fa_icon": "fas fa-chart-bar",
            "properties": {
                "schema_ignore_params": {
                    "type": "string",
                    "description": "Parameters to ignore during schema validation.",
                    "default": "genomes",
                    "fa_icon": "fas fa-eye-slash"
                }
            }
        },
        "generic_options": {
            "title": "Generic Options",
            "type": "object",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "fa_icon": "fas fa-file-import",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "description": "Method used to save pipeline results to output directory.",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "default": "copy",
                    "help_text": "The Nextflow `publishDir` option specifies which intermediate files should be saved to the output directory. This option tells the pipeline what method should be used to move these files. See [Nextflow docs](https://www.nextflow.io/docs/latest/process.html#publishdir) for details.",
                    "fa_icon": "fas fa-copy",
                    "hidden": true
                },
                "max_multiqc_email_size": {
                    "type": "string",
                    "description": "File size limit when attaching MultiQC reports to summary emails.",
                    "pattern": "^\\d+(\\.\\d+)?\\.?\\s*(K|M|G|T)?B$",
                    "default": "25.MB",
                    "fa_icon": "fas fa-file-upload",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "fa_icon": "fas fa-palette",
                    "hidden": true
                },
                "monochromeLogs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "fa_icon": "fas fa-palette",
                    "hidden": true
                },
                "hook_url": {
                    "type": "string",
                    "description": "Incoming hook URL for messaging service",
                    "fa_icon": "fas fa-people-group",
                    "help_text": "Incoming hook URL for messaging service. Currently, MS Teams and Slack are supported.",
                    "hidden": true
                },
                "multiqc_config": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Custom config file to supply to MultiQC.",
                    "fa_icon": "fas fa-cog",
                    "hidden": true
                },
                "multiqc_logo": {
                    "type": "string",
                    "description": "Custom logo file to supply to MultiQC. File name must also be set in the MultiQC config file",
                    "fa_icon": "fas fa-image",
                    "hidden": true
                },
                "multiqc_methods_description": {
                    "type": "string",
                    "description": "Custom MultiQC yaml file containing HTML including a methods description.",
                    "fa_icon": "fas fa-cog"
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "description": "Base URL or local path to location of pipeline test dataset files",
                    "default": "https://raw.githubusercontent.com/nf-core/test-datasets/",
                    "fa_icon": "far fa-check-circle",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "description": "Suffix to add to the trace report filename. Default is the date and time in the format yyyy-MM-dd_HH-mm-ss.",
                    "fa_icon": "far calendar",
                    "hidden": true
                }
            }
        },
        "pipeline_specific_options": {
            "title": "Pipeline specific options",
            "type": "object",
            "description": "Parameters specific to the MycoSNP pipeline.",
            "properties": {
                "assembler": {
                    "type": "string",
                    "description": "Assembler used for Pre-Mycosnp."
                },
                "shovill_depth": {
                    "type": "integer",
                    "description": "Depth for shovill assembly."
                },
                "genome_size": {
                    "type": "string",
                    "description": "Genome size for assembly."
                },
                "iqtree": {
                    "type": "boolean",
                    "description": "Enable IQ-TREE for phylogeny."
                },
                "raxmlng": {
                    "type": "boolean",
                    "description": "Enable RAxML-NG for phylogeny."
                },
                "save_debug": {
                    "type": "boolean",
                    "description": "Save debug files."
                },
                "mask": {
                    "type": "boolean",
                    "description": "Enable masking of reference."
                },
                "skip_samples": {
                    "type": "string",
                    "description": "Samples to skip from analysis."
                },
                "skip_samples_file": {
                    "type": "string",
                    "description": "File listing samples to skip from analysis."
                },
                "skip_combined_analysis": {
                    "type": "boolean",
                    "description": "Skip combined analysis step."
                },
                "skip_phylogeny": {
                    "type": "boolean",
                    "description": "Skip phylogeny step."
                },
                "ref_dir": {
                    "type": "string",
                    "description": "Reference files directory (invalidates specific declarations)."
                },
                "ref_masked_fasta": {
                    "type": "string",
                    "description": "Masked reference FASTA file."
                },
                "ref_fai": {
                    "type": "string",
                    "description": "Reference FAI index file."
                },
                "ref_bwa": {
                    "type": "string",
                    "description": "Reference BWA index file."
                },
                "amdp": {
                    "type": "boolean",
                    "description": "Enable AMD-P parameters."
                },
                "qc_thresholds": {
                    "type": "string",
                    "description": "Quality control thresholds."
                },
                "metadata_csv": {
                    "type": "string",
                    "format": "file-path",
                    "default": null,
                    "description": "Path to the metadata CSV file for AMD-P.",
                    "fa_icon": "fas fa-file-csv"
                },
                "geolocation_csv": {
                    "type": "string",
                    "description": "Path to geolocation CSV file."
                },
                "test_samples": {
                    "type": "string",
                    "default": null,
                    "description": "Comma-separated sample IDs to appear as stars in the microreact input metadata file",
                    "fa_icon": "fas fa-vial"
                },
                "percent_n": {
                    "type": "number",
                    "default": "8",
                    "description": "Quality control threshold for the percent of Ns (range 0-100)",
                    "fa_icon": "fas fa-sliders-h"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/pipeline_specific_options"
        },
        {
            "$ref": "#/$defs/institutional_config_options"
        },
        {
            "$ref": "#/$defs/mycosnp_options"
        },
        {
            "$ref": "#/$defs/reference_options"
        },
        {
            "$ref": "#/$defs/reporting_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
