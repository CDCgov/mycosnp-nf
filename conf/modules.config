/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: "${params.publish_dir_mode}",
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ========================================================================================
        SRA Tools - Sequence Read Archive Download
    ========================================================================================
    */

    withName: SRATOOLS_PREFETCH {
        publishDir = [
            path: { "${params.outdir}/sra" },
            enabled: false
        ]
    }

    withName: SRATOOLS_FASTERQDUMP {
        publishDir = [
            [
                path: { "${params.outdir}/fastq" },
                mode: 'copy',
                pattern: "*gz"
            ],
            [
                path: { "${params.outdir}/fastq/md5" },
                mode: 'copy',
                pattern: "*.md5"
            ]
        ]
    }

    /*
    ========================================================================================
        Read Processing - Lane Merging & Quality Control
    ========================================================================================
    */

    withName: LANE_MERGE {
        publishDir = [
            enabled: true,
            mode: "${params.publish_dir_mode}",
            path: { "${params.outdir}/samples/${meta.id}/lane_merge" },
            pattern: "*gz"
        ]
    }

    withName: FASTQC_RAW {
        ext.args   = '--quiet --dir .'
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/samples/${meta.id}/fastqc_raw" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: QC_REPORTSHEET {
        publishDir = [
            path: { "${params.outdir}/combined/qc_report" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: QC_PARSER {
        publishDir = [
            enabled: true,
            mode: "${params.publish_dir_mode}",
            path: { "${params.outdir}/aggregate_outputs" },
            pattern: "*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Variant Calling - GATK HaplotypeCaller
    ========================================================================================
    */

    withName: GATK4_HAPLOTYPECALLER {
        ext.args   = "-ERC GVCF --sample-ploidy \"${params.sample_ploidy}\""
        ext.prefix = { "${meta.id}.g" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variant_calling/haplotypecaller"},
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: GATK4_COMBINEGVCFS {
        ext.skip_samples      = params.skip_samples
        ext.skip_samples_file = params.skip_samples_file
        publishDir = [
            path: { "${params.outdir}/combined/gvcf"},
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GATK4_INDEXFEATUREFILE {
        ext.skip_samples      = params.skip_samples
        ext.skip_samples_file = params.skip_samples_file
        publishDir = [
            path: { "${params.outdir}/combined/gvcf_index"},
            mode: "${params.publish_dir_mode}",
            pattern: "*{.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Subworkflow: BWA Reference Preparation
    ========================================================================================
    */

    withName: NUCMER {
        ext.args   = "--maxmatch --nosimplify"
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/reference/masked" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{coords}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: COORDSTOBED {
        ext.args = "-r -H -T"
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/reference/masked" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.bed",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BEDTOOLS_MASKFASTA {
        publishDir = [
            path: { "${params.outdir}/reference/masked" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BWA_INDEX {
        publishDir = [
            enabled: "${params.save_reference}",
            path: { "${params.outdir}/reference/bwa" },
            mode: "${params.publish_dir_mode}",
            pattern: "bwa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_FAIDX {
        publishDir = [
            enabled: "${params.save_reference}",
            path: { "${params.outdir}/reference/fai" },
            mode: "${params.publish_dir_mode}",
            pattern: "*fai",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PICARD_CREATESEQUENCEDICTIONARY {
        publishDir = [
            enabled: "${params.save_reference}",
            path: { "${params.outdir}/reference/dict" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{dict}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Subworkflow: BWA Preprocessing - Read Quality & Alignment
    ========================================================================================
    */

    withName: SEQKIT_PAIR {
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/seqkit_pair" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.fastq.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SEQTK_SAMPLE {
        ext.args   = "-s12237"
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/seqkit_sample" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.fastq.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FAQCS {
        ext.args   = "--debug"
        publishDir = [
            [
                enabled: "${params.save_alignment}",
                path: { "${params.outdir}/samples/${meta.id}/faqcs" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{fastq.gz,txt,log,pdf}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                enabled: "${params.save_alignment}",
                path: { "${params.outdir}/samples/${meta.id}/faqcs" },
                mode: "${params.publish_dir_mode}",
                pattern: "debug/**",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: BWA_MEM {
        ext.args   = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:library\\tPL:ILLUMINA\\tPU:barcode'" }
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/bwamem" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.bam",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        BAM Processing - Picard Tools
    ========================================================================================
    */

    withName: PICARD_MARKDUPLICATES {
        ext.args   = "--REMOVE_DUPLICATES true --ASSUME_SORT_ORDER coordinate --VALIDATION_STRINGENCY LENIENT --CREATE_INDEX true"
        ext.prefix = { "${meta.id}_markdups" }
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/picard_markduplicates" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.bam",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PICARD_CLEANSAM {
        ext.prefix = { "${meta.id}_clean" }
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/picard_cleansam" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.bam",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PICARD_FIXMATEINFORMATION {
        ext.prefix     = { "${meta.id}_fixmate" }
        ext.stringency = "LENIENT"
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/picard_fixmate" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.bam",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PICARD_ADDORREPLACEREADGROUPS {
        ext.args   = { "--CREATE_INDEX true --ID ${meta.id} --LB library --PL ILLUMINA --PU barcode --SM ${meta.id}" }
        ext.prefix = { "${meta.id}.final" }
        publishDir = [
            enabled: "${params.save_alignment}",
            mode: "${params.publish_dir_mode}",
            path: { "${params.outdir}/samples/${meta.id}/finalbam" },
            pattern: "*.bam"
        ]
    }

    /*
    ========================================================================================
        BAM Processing - Samtools
    ========================================================================================
    */

    withName: SAMTOOLS_VIEW {
        ext.args   = "-S -b"
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/samples/${meta.id}/samtobam" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.sam",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_INDEX {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/samples/${meta.id}/finalbam" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.bai",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_STATS {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/combined/samtools_stats" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.stats",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_FLAGSTAT {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/combined/samtools_flagstat" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.flagstat",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_IDXSTATS {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/combined/samtools_idxstats" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.idxstats",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_COVERAGE {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/combined/samtools_coverage" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.txt",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_DEPTH {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/combined/samtools_depth" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Post-Alignment Quality Control
    ========================================================================================
    */

    withName: FASTQC_POST {
        ext.args   = '--quiet --dir .'
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/samples/${meta.id}/fastqc_post" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: QC_REPORT {
        publishDir = [
            enabled: "${params.save_alignment}",
            path: { "${params.outdir}/samples/${meta.id}/qc_report" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{txt}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Subworkflow: GATK Variant Processing
    ========================================================================================
    */

    withName: GATK4_GENOTYPEGVCFS {
        ext.prefix = "combined_genotype"
        publishDir = [
            path: { "${params.outdir}/combined/genotypegvcfs" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GATK4_VARIANTFILTRATION {
        ext.args   = "--filter-expression '${params.gvcfs_filter}' --filter-name filter"
        ext.prefix = "combined_genotype_filtered"
        publishDir = [
            path: { "${params.outdir}/combined/filteredgvcfs" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GATK4_SELECTVARIANTS {
        ext.args   = '--select-type-to-include "SNP"'
        ext.prefix = "combined_genotype_filtered_snps"
        publishDir = [
            path: { "${params.outdir}/combined/selectedsnps" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FILTER_GATK_GENOTYPES {
        ext.args   = params.gatkgenotypes_filter
        ext.prefix = "combined_genotype_filtered_snps_filtered"
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/combined/selectedsnpsfiltered" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        VCF Processing - BCFtools & Custom Scripts
    ========================================================================================
    */

    withName: BCFTOOLS_VIEW_CONVERT {
        ext.args   = "-Oz"
        ext.prefix = "finalfiltered"
        publishDir = [
            path: { "${params.outdir}/combined/finalfiltered" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BCFTOOLS_INDEX {
        publishDir = [
            path: { "${params.outdir}/combined/selectedsnpsfiltered" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{csi,tbi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SPLIT_VCF {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/splitvcf" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{txt,vcf.gz}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VCF_TO_FASTA {
        publishDir = [
            enabled: false,
            path: { "${params.outdir}/combined/vcf-to-fasta" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{fasta}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VCF_QC {
        publishDir = [
            path: { "${params.outdir}/combined/vcf-qc-report" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{report.txt,samples.txt}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VCF_CONSENSUS {
        publishDir = [
            enabled: "${params.save_debug}",
            path: { "${params.outdir}/combined/consensus" },
            mode: "${params.publish_dir_mode}",
            pattern: "*{fasta.gz}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Subworkflow: SNP Effect Annotation
    ========================================================================================
    */

    withName: SNPEFF_SNPEFF {
        ext.args = '-config $PWD/data/snpEff.config'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/snpeff" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{csv,txt,html}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: TABIX_BGZIPTABIX {
        ext.prefix = { "${meta.id}.snpeff" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/snpeff" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{tbi,gz}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SNPEFFR {
        ext.args   = "-p ${params.positions} -g ${params.genes} -e ${params.exclude}"
        publishDir = [
            path: { "${params.outdir}/aggregate_outputs" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{csv}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ========================================================================================
        Subworkflow: Phylogenetic Analysis
    ========================================================================================
    */

    withName: SEQKIT_REPLACE {
        ext.args   = "-s -p '\\*' -r '-'"
        ext.suffix = "fasta"
        ext.prefix = "vcf-to-fasta"
        publishDir = [
            path: { "${params.outdir}/combined/vcf-to-fasta" },
            mode: "${params.publish_dir_mode}",
            pattern: "vcf-to-fasta.fasta",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SNPDISTS {
        publishDir = [
            path: { "${params.outdir}/combined/snpdists" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: RAPIDNJ {
        ext.args   = "-t d -b 1000 -n"
        publishDir = [
            path: { "${params.outdir}/combined/phylogeny/rapidnj" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename ->
                if (filename.endsWith(".tre")) {
                    return "rapidnj_phylogeny.nh"
                } else {
                    filename.equals('versions.yml') ? null : filename
                }
            }
        ]
    }

    withName: FASTTREE {
        ext.args   = "-gtr -gamma -fastest"
        publishDir = [
            path: { "${params.outdir}/combined/phylogeny/fasttree" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename ->
                if (filename.endsWith(".tre")) {
                    return "fasttree_phylogeny.nh"
                } else {
                    return filename.equals('versions.yml') ? null : filename
                }
            }
        ]
    }

    withName: IQTREE {
        ext.args   = "-alrt 1000 -B 1000 -m MFP -czb"
        publishDir = [
            path: { "${params.outdir}/combined/phylogeny/iqtree" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename ->
                if (filename.endsWith(".treefile")) {
                    return "iqtree_phylogeny.nh"
                } else {
                    return filename.equals('versions.yml') ? null : filename
                }
            }
        ]
    }

    withName: RAXMLNG {
        ext.args   = "--all --model GTR+G --bs-trees 1000"
        publishDir = [
            path: { "${params.outdir}/combined/phylogeny/raxmlng" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename ->
                if (filename.endsWith(".bestTree")) {
                    return "raxmlng_bestTree.nh"
                } else if (filename.endsWith(".support")) {
                    return "raxmlng_support.nh"
                } else {
                    return filename.equals('versions.yml') ? null : filename
                }
            }
        ]
    }

    withName: QUICKSNP {
        publishDir = [
            path: { "${params.outdir}/combined/phylogeny/quicksnp" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.nwk",
            saveAs: { filename ->
                if (filename.endsWith(".nwk")) {
                    return "quicksnp_phylogeny.nwk"
                } else {
                    return filename.equals('versions.yml') ? null : filename
                }
            }
        ]
    }

    /*
    ========================================================================================
        Workflow: Pre-MycoSNP Processing
    ========================================================================================
    */

    withName: SHOVILL {
        ext.args   = "--assembler ${params.assembler} --depth ${params.shovill_depth} --mincov ${params.min_contig_cov} --minlen ${params.min_contig_len} --nocorr --tmpdir ./tmp"
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/assembly" },
            mode: "${params.publish_dir_mode}",
            pattern: "contigs.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : "${meta.id}.fa" }
        ]
    }

    withName: GAMBIT_QUERY {
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/taxonomy" },
            mode: "${params.publish_dir_mode}",
            pattern: "*_gambit.csv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUBTYPE {
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/subtype" },
            mode: "${params.publish_dir_mode}",
            pattern: "*_subtype.csv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PRE_MYCOSNP_INDV_SUMMARY {
        stageInMode = 'copy'
        publishDir  = [
            path: { "${params.outdir}/samples/${meta.id}/pre-mycosnp_summary" },
            mode: "${params.publish_dir_mode}",
            pattern: "*_linesummary.csv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
